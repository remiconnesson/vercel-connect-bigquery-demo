# BigQuery resource configuration. These values are not credentials.
GCP_PROJECT_ID=fir-testing-71fef
BIGQUERY_LOCATION=EU
BIGQUERY_GOVERNED_DATASET=connect_governed

# The connector UID is not a secret. It is added after the Google Custom OAuth
# connector is created and attached to the project.
VERCEL_CONNECTOR_UID=

# Optional local-only Passport identity fallback. Never used in production.
PASSPORT_DEV_USER=you@example.com
